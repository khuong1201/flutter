// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             String    @id @default(uuid()) @db.Uuid
  email          String    @unique @db.VarChar(100)
  passwordHash   String?   @map("password_hash") @db.VarChar(255)
  refreshToken   String?   @map("refresh_token") @db.Text
  provider       String?   @db.VarChar(50)
  providerId     String?   @map("provider_id") @db.VarChar(255)
  fullName       String    @map("full_name") @db.VarChar(100)
  avatarUrl      String?   @map("avatar_url") @db.VarChar(255)
  targetLanguage String    @map("target_language") @db.VarChar(10)
  targetLevel    String?   @map("target_level") @db.VarChar(20)
  xpPoints       Int       @default(0) @map("xp_points")
  currentStreak  Int       @default(0) @map("current_streak")
  longestStreak  Int       @default(0) @map("longest_streak")
  lastStudyDate  DateTime? @map("last_study_date")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at")

  progress      UserProgress[]
  reviewLogs    ReviewLog[]
  userLessons   UserLesson[]
  contributions UserContribution[]

  @@map("users")
}

model Level {
  id       Int    @id @default(autoincrement())
  system   String @db.VarChar(20)
  code     String @db.VarChar(20)
  name     String @db.VarChar(50)
  language String @db.VarChar(10)

  lessons Lesson[]

  @@unique([system, code])
  @@map("levels")
}

model Lesson {
  id         Int    @id @default(autoincrement())
  levelId    Int    @map("level_id")
  title      String @db.VarChar(150)
  orderIndex Int    @map("order_index")

  level        Level              @relation(fields: [levelId], references: [id])
  vocabularies LessonVocabulary[]
  userLessons  UserLesson[]

  @@map("lessons")
}

model LessonVocabulary {
  lessonId     Int @map("lesson_id")
  vocabularyId Int @map("vocabulary_id")
  orderIndex   Int @map("order_index")

  lesson     Lesson     @relation(fields: [lessonId], references: [id])
  vocabulary Vocabulary @relation(fields: [vocabularyId], references: [id])

  @@id([lessonId, vocabularyId])
  @@map("lesson_vocabularies")
}

model Vocabulary {
  id        Int      @id @default(autoincrement())
  word      String   @db.VarChar(100)
  meaning   String   @db.Text
  language  String   @db.VarChar(10)
  audioKey  String?  @map("audio_key") @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  readings   VocabularyReading[]
  characters VocabularyCharacter[]
  lessons    LessonVocabulary[]

  @@map("vocabularies")
}

model VocabularyReading {
  id           Int     @id @default(autoincrement())
  vocabularyId Int     @map("vocabulary_id")
  reading      String  @db.VarChar(255)
  pinyin       String? @db.VarChar(255)
  kana         String? @db.VarChar(255)
  romaji       String? @db.VarChar(255)

  vocabulary Vocabulary @relation(fields: [vocabularyId], references: [id])

  @@map("vocabulary_readings")
}

model VocabularyCharacter {
  vocabularyId Int @map("vocabulary_id")
  characterId  Int @map("character_id")
  orderIndex   Int @map("order_index")

  vocabulary Vocabulary @relation(fields: [vocabularyId], references: [id])
  character  Character  @relation(fields: [characterId], references: [id])

  @@id([vocabularyId, characterId])
  @@map("vocabulary_characters")
}

model Character {
  id       Int     @id @default(autoincrement())
  charText String  @map("char_text") @db.VarChar(5)
  language String  @db.VarChar(10)
  meaning  String  @db.Text
  audioKey String? @map("audio_key") @db.VarChar(255)

  readings     CharacterReading[]
  strokes      CharacterStroke[]
  vocabularies VocabularyCharacter[]
  radicals     CharacterRadical[]
  progress     UserProgress[]
  reviewLogs   ReviewLog[]

  @@unique([charText, language])
  @@map("characters")
}

model CharacterReading {
  id          Int     @id @default(autoincrement())
  characterId Int     @map("character_id")
  reading     String  @db.VarChar(255)
  pinyin      String? @db.VarChar(255)
  kana        String? @db.VarChar(255)
  romaji      String? @db.VarChar(255)
  readingType String? @map("reading_type") @db.VarChar(50)

  character Character @relation(fields: [characterId], references: [id])

  @@map("character_readings")
}

model CharacterStroke {
  id          Int    @id @default(autoincrement())
  characterId Int    @map("character_id")
  order       Int
  medianPath  String @map("median_path") @db.Text
  outlinePath String @map("outline_path") @db.Text

  character Character @relation(fields: [characterId], references: [id])

  @@unique([characterId, order])
  @@map("character_strokes")
}

model Radical {
  id          Int    @id @default(autoincrement())
  radicalText String @map("radical_text") @db.VarChar(5)
  meaning     String @db.VarChar(100)
  variants    Json?

  characters CharacterRadical[]

  @@map("radicals")
}

model CharacterRadical {
  characterId Int @map("character_id")
  radicalId   Int @map("radical_id")

  character Character @relation(fields: [characterId], references: [id])
  radical   Radical   @relation(fields: [radicalId], references: [id])

  @@id([characterId, radicalId])
  @@map("character_radicals")
}

model UserProgress {
  id                 String   @id @default(uuid()) @db.Uuid
  userId             String   @map("user_id") @db.Uuid
  characterId        Int      @map("character_id")
  status             String   @default("learning") @db.VarChar(20)
  easeFactor         Decimal  @default(2.50) @map("ease_factor") @db.Decimal(5, 2)
  intervalDays       Int      @default(0) @map("interval_days")
  nextReviewAt       DateTime @map("next_review_at")
  totalReviews       Int      @default(0) @map("total_reviews")
  consecutiveCorrect Int      @default(0) @map("consecutive_correct")

  user      User      @relation(fields: [userId], references: [id])
  character Character @relation(fields: [characterId], references: [id])

  @@map("user_progress")
}

model ReviewLog {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  characterId  Int      @map("character_id")
  actionType   String   @map("action_type") @db.VarChar(20)
  grade        Int
  errorDetails Json?    @map("error_details")
  createdAt    DateTime @default(now()) @map("created_at")

  user      User      @relation(fields: [userId], references: [id])
  character Character @relation(fields: [characterId], references: [id])

  @@map("review_logs")
}

model UserLesson {
  userId      String    @map("user_id") @db.Uuid
  lessonId    Int       @map("lesson_id")
  status      String    @default("locked") @db.VarChar(20)
  completedAt DateTime? @map("completed_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at")

  user   User   @relation(fields: [userId], references: [id])
  lesson Lesson @relation(fields: [lessonId], references: [id])

  @@id([userId, lessonId])
  @@map("user_lessons")
}

model UserContribution {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  date      DateTime @db.Date
  count     Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, date])
  @@map("user_contributions")
}

model DatasetVersion {
  id          Int      @id @default(autoincrement())
  source      String   @db.VarChar(50)
  version     String   @db.VarChar(50)
  status      String   @db.VarChar(20)
  error       String?  @db.Text
  datasetType String?  @map("dataset_type") @db.VarChar(50)
  sourceUrl   String?  @map("source_url") @db.Text
  recordCount Int?     @map("record_count")
  importedAt  DateTime @default(now()) @map("imported_at")

  @@unique([source, version])
  @@map("dataset_versions")
}
